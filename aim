#!/usr/bin/env bash
# aim-opencode CLI wrapper — nested OS (aim-agy_os)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OS_ROOT="$ROOT/aim-agy_os"
VENV_PY="$OS_ROOT/venv/bin/python3"
# fallbacks during migration
if [[ ! -x "$VENV_PY" ]]; then
  VENV_PY="$ROOT/venv/bin/python3"
fi
CLI="$OS_ROOT/.aim_core/aim_cli.py"

if [[ ! -x "$VENV_PY" ]]; then
  echo "[aim-opencode] venv missing. Run: bash aim-agy_os/setup.sh" >&2
  exit 1
fi
if [[ ! -f "$CLI" ]]; then
  echo "[aim-opencode] aim_cli.py missing at $CLI" >&2
  exit 1
fi

export PYTHONPATH="${OS_ROOT}:${OS_ROOT}/.aim_core${PYTHONPATH:+:$PYTHONPATH}"
export AIM_VESSEL_CLI="${AIM_VESSEL_CLI:-opencode}"
exec "$VENV_PY" "$CLI" "$@"
